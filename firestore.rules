rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGroupSession() { return signedIn() && 'groupSession' in request.auth.token && request.auth.token.groupSession == true; }
    function sessionAllows(groupId) { return !isGroupSession() || request.auth.token.groupId == groupId; }
    function membershipPath(groupId) { return /databases/$(database)/documents/groups/$(groupId)/userMemberships/$(request.auth.uid); }
    function isMember(groupId) { return signedIn() && sessionAllows(groupId) && exists(membershipPath(groupId)); }
    function isMemberAfter(groupId) { return signedIn() && sessionAllows(groupId) && existsAfter(membershipPath(groupId)); }
    function isOwner(groupId) { return signedIn() && !isGroupSession() && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid; }
    function verifiedEmailMatches(data) { return signedIn() && !isGroupSession() && request.auth.token.email_verified == true && request.auth.token.email == data.email; }
    function isSyntheticGroupUid(value) { return value is string && value.matches('^group-[0-9a-f]{32}$'); }

    match /groups/{groupId} {
      allow create: if signedIn() && !isGroupSession() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(groupId);
      allow update, delete: if isOwner(groupId);

      match /members/{memberId} {
        allow read: if isMember(groupId) || verifiedEmailMatches(resource.data);
        allow create: if isMemberAfter(groupId) && (
          request.resource.data.userId == null
          || (!exists(/databases/$(database)/documents/groups/$(groupId))
            && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
            && request.resource.data.userId == request.auth.uid)
        );
        allow update: if (isOwner(groupId)) || (
          (resource.data.userId == null || isSyntheticGroupUid(resource.data.userId))
          && request.resource.data.userId == request.auth.uid
          && verifiedEmailMatches(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId'])
          && isMemberAfter(groupId)
        );
        allow delete: if isOwner(groupId);
      }

      match /userMemberships/{userId} {
        allow read: if signedIn() && sessionAllows(groupId) && (userId == request.auth.uid || isOwner(groupId));
        allow create: if signedIn() && !isGroupSession() && userId == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && (
            (getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
              && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data.userId == request.auth.uid)
            || (verifiedEmailMatches(get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data)
              && (get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data.userId == null
                || isSyntheticGroupUid(get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.resource.data.memberId)).data.userId)))
          );
        allow update: if false;
        allow delete: if isOwner(groupId);
      }

      match /debts/{debtId} {
        allow read, create: if isMember(groupId);
        allow update: if isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAmount'])
          && request.resource.data.paidAmount is number
          && resource.data.paidAmount is number
          && request.resource.data.paidAmount > resource.data.paidAmount
          && request.resource.data.paidAmount <= resource.data.amount
          && (
            (request.resource.data.status == 'parcial'
              && request.resource.data.paidAmount < resource.data.amount)
            || (request.resource.data.status == 'pagada'
              && request.resource.data.paidAmount == resource.data.amount)
          )
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(resource.data.lenderId)).data.userId == request.auth.uid;
        allow delete: if isOwner(groupId);
      }
    }
    match /accessCodes/{code} {
      allow get: if signedIn() && !isGroupSession(); allow list: if false;
      allow create: if signedIn() && !isGroupSession() && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{path=**}/members/{memberId} {
      // The verified email may discover pending, synthetic direct-access, and
      // already-claimed rows. Updates still accept only null or group-* UIDs.
      // Restricted group sessions are rejected by verifiedEmailMatches().
      allow read: if verifiedEmailMatches(resource.data);
    }
    match /appMetadata/{document} { allow read: if signedIn() && !isGroupSession(); allow write: if false; }
  }
}
